---
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import EditorialSection from "@/components/marketing/EditorialSection.astro";
import CodeProof from "@/components/marketing/CodeProof.astro";

const buildCode = `import (
    "github.com/lookatitude/beluga-ai/v2/agent"
    "github.com/lookatitude/beluga-ai/v2/config"
    "github.com/lookatitude/beluga-ai/v2/llm"
    _ "github.com/lookatitude/beluga-ai/v2/llm/providers/anthropic"
    "github.com/lookatitude/beluga-ai/v2/tool"
)

model, err := llm.New("anthropic", config.ProviderConfig{Model: "claude-sonnet-4-6"})
if err != nil {
    return err
}

search := tool.NewFuncTool("search", "Search the knowledge base",
    func(ctx context.Context, in SearchInput) (*tool.Result, error) {
        return tool.TextResult(lookup(in.Query)), nil
    })

researcher := agent.New("researcher",
    agent.WithLLM(model),
    agent.WithPersona(agent.Persona{Role: "senior researcher", Traits: []string{"cites sources"}}),
    agent.WithPlannerName("react"),
    agent.WithTools([]tool.Tool{search}),
)

for ev, err := range researcher.Stream(ctx, "summarise streaming-first patterns in Beluga") {
    if err != nil {
        return err
    }
    if ev.Type == agent.EventText {
        fmt.Print(ev.Text)
    }
}`;

const knowCode = `import (
    "github.com/lookatitude/beluga-ai/v2/config"
    "github.com/lookatitude/beluga-ai/v2/rag/embedding"
    _ "github.com/lookatitude/beluga-ai/v2/rag/embedding/providers/openai"
    "github.com/lookatitude/beluga-ai/v2/rag/retriever"
    "github.com/lookatitude/beluga-ai/v2/rag/vectorstore"
    _ "github.com/lookatitude/beluga-ai/v2/rag/vectorstore/providers/pgvector"
)

emb, err := embedding.New("openai", config.ProviderConfig{Model: "text-embedding-3-small"})
if err != nil {
    return err
}
store, err := vectorstore.New("pgvector", config.ProviderConfig{
    BaseURL: "postgres://beluga@db:5432/kb",
    Options: map[string]any{"dimension": 1536.0},
})
if err != nil {
    return err
}

// Hybrid retrieval: dense vectors + BM25 (any retriever.BM25Searcher),
// fused with Reciprocal Rank Fusion.
hybrid := retriever.NewHybridRetriever(store, emb, bm25Index, retriever.WithHybridRRFK(60))

docs, err := hybrid.Retrieve(ctx, "how does crash-durable workflow replay work?", retriever.WithTopK(10))`;

const shipCode = `// Resilience + observability + safety compose on the same interface.
// The first middleware listed is the outermost wrapper.
safeModel := llm.ApplyMiddleware(base,
    llm.WithHooks(guardHooks), // guard.Pipeline checks in BeforeGenerate
    llm.WithTracing(),         // gen_ai.* OTel spans at every boundary
    llm.WithProviderLimits(llm.ProviderLimits{RPM: 60, MaxConcurrent: 10}),
    llm.WithFallback(backup),  // switch models when the primary fails
)

// Retries wrap the call site and only retry errors core.IsRetryable accepts.
resp, err := resilience.Retry(ctx, resilience.DefaultRetryPolicy(),
    func(ctx context.Context) (*schema.AIMessage, error) {
        return safeModel.Generate(ctx, msgs)
    })`;

const voiceCode = `import (
    "github.com/lookatitude/beluga-ai/v2/voice"
    "github.com/lookatitude/beluga-ai/v2/voice/stt"
    _ "github.com/lookatitude/beluga-ai/v2/voice/stt/providers/deepgram"
    "github.com/lookatitude/beluga-ai/v2/voice/transport"
    "github.com/lookatitude/beluga-ai/v2/voice/tts"
    _ "github.com/lookatitude/beluga-ai/v2/voice/tts/providers/cartesia"
    _ "github.com/lookatitude/beluga-ai/v2/voice/vad/providers/silero"
)

recognizer, err := stt.New("deepgram", stt.Config{
    Model: "nova-3",
    Extra: map[string]any{"api_key": os.Getenv("DEEPGRAM_API_KEY")},
})
if err != nil {
    return err
}
synth, err := tts.New("cartesia", tts.Config{
    Extra: map[string]any{"api_key": os.Getenv("CARTESIA_API_KEY")},
})
if err != nil {
    return err
}
vad, err := voice.NewVAD("silero", map[string]any{"threshold": 0.5})
if err != nil {
    return err
}
conn, err := transport.NewWebSocketTransport(ctx, "wss://voice.example.com/session")
if err != nil {
    return err
}

// Frame-based: VAD gates audio into STT, text flows to your agent,
// and TTS streams audio back over the same transport.
pipe := voice.NewPipeline(
    voice.WithTransport(conn),
    voice.WithVAD(vad),
    voice.WithSTT(stt.AsFrameProcessor(recognizer)),
    voice.WithLLM(agentProcessor), // your voice.FrameProcessor around an agent
    voice.WithTTS(tts.AsFrameProcessor(synth, 24000)),
)
err = pipe.Run(ctx)`;

const protocolCode = `import (
    "github.com/lookatitude/beluga-ai/v2/protocol/a2a"
    "github.com/lookatitude/beluga-ai/v2/protocol/rest"
)

api := rest.NewServer()
if err := api.RegisterAgent("/agents/researcher", researcher); err != nil {
    return err
}
peer := a2a.NewServer(researcher, a2a.AgentCard{
    Name:     "researcher",
    Endpoint: "https://agents.example.com",
})

errc := make(chan error, 2)
go func() { errc <- api.Serve(ctx, ":3000") }()  // REST + SSE streaming
go func() { errc <- peer.Serve(ctx, ":8081") }() // A2A, /.well-known/agent.json
return <-errc`;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Product — Beluga AI",
  description: "A complete agent stack organized around Build, Know, and Ship.",
  url: "https://beluga-ai.org/product/",
});
---

<MarketingLayout
  title="Product"
  description="A complete agent stack organized around Build, Know, and Ship — agent runtime, LLM abstraction, RAG, voice, memory, tools, orchestration, guardrails, observability, protocols."
  jsonLd={jsonLd}
>
  <!-- P1 · Intro -->
  <section class="page-intro">
    <div class="page-intro-frame">
      <span class="eyebrow">PRODUCT</span>
      <h1 class="page-headline">What Beluga can do.</h1>
      <p class="page-deck">
        A complete agent stack organized around three concerns.
        <em>Build</em> is where agents come from.
        <em>Know</em> is what agents remember and retrieve.
        <em>Ship</em> is how agents behave in production.
      </p>
      <nav class="pi-jump" aria-label="Jump to section">
        <a href="#build">Build</a>
        <a href="#know">Know</a>
        <a href="#ship">Ship</a>
        <a href="#voice">Voice</a>
        <a href="#protocols">Protocols</a>
      </nav>
    </div>
  </section>

  <!-- P2 · Build -->
  <EditorialSection
    eyebrow="BUILD"
    headline="Agents that reason, act, and recover."
    headlineFont="display"
    deck="The runtime runs a Plan → Act → Observe → Replan loop on every turn. Eight planning strategies share one Planner interface — swap them with a config change. LLM calls route across 22 providers with a unified ChatModel. Tools are any Go function wrapped with a schema. Handoffs between agents are auto-generated tools."
    layout="split"
    cite={{ label: "Agent anatomy", href: "/docs/concepts/extensibility/" }}
    class="section-build"
  >
    <CodeProof
      code={buildCode}
      lang="go"
      title="examples/research-agent.go"
      caption={`ReAct planner with two tools, streamed to the caller. Swap WithPlannerName("react") for "lats", "tot", or "moa" without touching the rest.`}
      cite={{ label: "The eight reasoning strategies", href: "/docs/guides/capabilities/agents/" }}
    />
  </EditorialSection>

  <div id="build" class="anchor-offset"></div>

  <!-- P3 · Know -->
  <EditorialSection
    eyebrow="KNOW"
    headline="Memory that persists. Retrieval that finds the right thing."
    headlineFont="display"
    deck="Three-tier memory — working, recall, archival — with graph-store support. RAG uses hybrid retrieval: BM25 and dense vectors, fused with Reciprocal Rank Fusion. Strategies include CRAG, Adaptive RAG, HyDE, multi-query, and RAPTOR. Thirteen vector-store backends, nine embedding providers, eight memory stores."
    layout="split"
    bleed
    cite={{ label: "RAG pipeline guide", href: "/docs/guides/capabilities/rag/" }}
  >
    <CodeProof
      code={knowCode}
      lang="go"
      title="examples/hybrid-retrieval.go"
      caption="BM25 + dense vector retrieval fused with RRF — the recommended default for most knowledge bases."
    />
  </EditorialSection>

  <div id="know" class="anchor-offset"></div>

  <!-- P4 · Ship -->
  <EditorialSection
    eyebrow="SHIP"
    headline="Production defaults, not production afterthoughts."
    headlineFont="display"
    deck="The guard pipeline runs three stages — Input, Output, Tool — around every LLM interaction. Rate limits, fallback, hooks, and tracing are middleware on the same interface as your LLM call; retry and circuit breakers wrap the call site. OTel GenAI spans emit from 17 packages at every boundary. Durable workflows replay from an event log. Cost tracking attributes every token to a team."
    layout="split"
    cite={{ label: "Production defaults — observability, resilience, durability", href: "/docs/guides/production/" }}
  >
    <CodeProof
      code={shipCode}
      lang="go"
      title="main.go · wrapping a model for production"
      caption="Four middlewares around base plus retry at the call site is the difference between a demo and a system you page on."
    />
  </EditorialSection>

  <div id="ship" class="anchor-offset"></div>

  <!-- P5 · Voice -->
  <EditorialSection
    eyebrow="VOICE"
    headline="Frame-based voice, built in."
    headlineFont="display"
    deck="STT → LLM → TTS as a typed pipeline. Six STT providers, seven TTS providers, three speech-to-speech providers. A WebSocket transport today; the LiveKit, Daily, and Pipecat transport adapters are registered but not yet functional. Silero and WebRTC VAD. No other Go agent framework includes this."
    layout="split"
    bleed
    cite={{ label: "Voice pipeline guide", href: "/docs/guides/capabilities/voice/" }}
  >
    <CodeProof
      code={voiceCode}
      lang="go"
      title="examples/voice-agent.go"
    />
  </EditorialSection>

  <div id="voice" class="anchor-offset"></div>

  <!-- P6 · Protocols -->
  <EditorialSection
    eyebrow="PROTOCOLS"
    headline="Agents meet the network."
    headlineFont="display"
    deck="Expose the same Agent over MCP for tools, A2A for inter-agent discovery, REST/SSE for streaming clients, gRPC for low-latency internal calls, or WebSocket for bidirectional voice. Pick one or ship them all — the Runner is the deployment boundary, not the agent."
    layout="split"
    cite={{ label: "Protocol layer guide", href: "/docs/guides/production/" }}
  >
    <CodeProof
      code={protocolCode}
      lang="go"
      title="examples/serve.go"
    />
  </EditorialSection>

  <div id="protocols" class="anchor-offset"></div>

  <!-- Final CTA -->
  <section class="product-cta">
    <div class="pc-frame">
      <h2 class="font-display">Everything you just read is open source.</h2>
      <p>MIT licensed. 110 providers. Zero paid tiers.</p>
      <div class="pc-actions">
        <a href="/docs/start/quick-start/" class="btn btn-primary">Read the quickstart</a>
        <a href="/compare/" class="btn btn-ghost">Compare with alternatives →</a>
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  /* .page-intro / .page-intro-frame / .page-headline / .page-deck
     and .eyebrow live in components.css. */

  /* Page-specific deck embellishment — lets <em> inside the deck
     read as a load-bearing keyword without italicising. */
  .page-intro .page-deck em {
    font-style: normal;
    color: var(--sl-color-white);
    font-weight: 500;
  }

  /* Jump nav */
  .pi-jump {
    display: flex;
    gap: 1.75rem;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    flex-wrap: wrap;
  }
  .pi-jump a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
    padding-bottom: 0.125rem;
    border-bottom: 1px solid transparent;
    transition: color 0.15s ease, border-color 0.2s ease;
  }
  .pi-jump a:hover {
    color: var(--brand-300);
    border-bottom-color: var(--brand-300);
  }

  /* Anchor offset so in-page links land below the sticky header */
  .anchor-offset {
    display: block;
    height: 1px;
    margin-top: -5rem;
    padding-top: 5rem;
    visibility: hidden;
  }

  /* Final CTA */
  .product-cta {
    padding-block: clamp(5rem, 10vw, 8rem);
    border-top: 1px solid var(--sl-color-hairline);
  }
  .pc-frame {
    max-width: 52rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }
  .pc-frame h2 {
    font-family: var(--font-sans);
    font-size: var(--text-h1);
    line-height: var(--lh-h1);
    letter-spacing: var(--track-h1);
    font-weight: 500;
    color: var(--sl-color-white);
    margin: 0;
    max-width: 18ch;
    text-wrap: balance;
  }
  .pc-frame p {
    font-size: var(--text-lead);
    line-height: var(--lh-body);
    color: var(--sl-color-gray-2);
    margin: 0;
  }
  .pc-actions {
    display: flex;
    gap: 1.25rem;
    align-items: center;
    margin-top: 0.75rem;
    flex-wrap: wrap;
  }

  /* .btn / .btn-primary / .btn-ghost live in components.css */
</style>
